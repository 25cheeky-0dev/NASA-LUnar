            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Site Ids"
          },
          "start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Start Utc"
          },
          "end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "End Utc"
          },
          "min_continuous_overlap_minutes": {
            "type": "number",
            "maximum": 2880.0,
            "exclusiveMinimum": 0.0,
            "title": "Min Continuous Overlap Minutes",
            "default": 180
          },
          "horizon_model": {
            "type": "string",
            "enum": [
              "GEOMETRIC",
              "LOCAL_TERRAIN"
            ],
            "title": "Horizon Model",
            "default": "GEOMETRIC"
          },
          "observer_height_m": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Observer Height M",
            "default": 1
          },
          "step_minutes": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Step Minutes",
            "default": 5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site_ids",
          "start_utc",
          "end_utc"
        ],
        "title": "AnalyzeRequest"
