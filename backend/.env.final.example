# Paths to existing verified assets; no credentials required for public NASA sources.
WISPR_GRID_DIR=/absolute/path/to/WISPR_Site04_Tiling_V3
WISPR_TERRAIN_V3_DIR=/absolute/path/to/WISPR_Site04_Tiling_V3
WISPR_GLOBAL_ROOT=/absolute/path/to/lunar-v1
CELESTIAL_CACHE_DIR=/absolute/path/to/celestial-cache
WISPR_MODEL_DIR=/absolute/path/to/models
CORS_ORIGINS=http://localhost:5173
# Load explicitly into the process environment. Bind uvicorn to 127.0.0.1 by default.
